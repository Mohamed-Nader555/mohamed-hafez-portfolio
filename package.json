{
  "name": "portfolio-implementation",
  "version": "1.0.0",
  "description": "Official portfolio for Mohamed Hafez: an evidence-led recruiter experience spanning AI/ML engineering, software engineering, Android development, and technical teaching.",
  "private": true,
  "type": "module",
  "scripts": {
    "assets:images": "tsx scripts/optimize-project-images.ts",
    "assets:verify": "tsx scripts/verify-public-assets.ts",
    "budget:js": "tsx scripts/verify-javascript-budgets.ts",
    "dev": "wrangler types && astro dev",
    "build": "wrangler types && astro check && astro build",
    "check": "wrangler types && astro check",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "knowledge:build": "node -e \"console.error('knowledge:build is pending the grounded-AI phase.'); process.exit(1)\"",
    "knowledge:evaluate": "node -e \"console.error('knowledge:evaluate is pending the grounded-AI phase.'); process.exit(1)\"",
    "deploy:dry": "wrangler deploy --dry-run --outdir bundled",
    "deploy": "wrangler deploy"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.1",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/react": "^6.0.2",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.2",
    "lucide-react": "^1.31.0",
    "minisearch": "^7.2.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-plugin-astro": "^3.1.0",
    "jsdom": "^30.0.1",
    "mdast-util-from-markdown": "^2.0.3",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.35.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0",
    "yaml": "^2.9.0"
  }
}
