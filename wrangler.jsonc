{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mohamed-hafez-portfolio",
  "compatibility_date": "2026-08-14",
  "ai": { "binding": "AI" },
  "vars": {
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
    "PUBLIC_TURNSTILE_SITEKEY": "0x4AAAAAAEYpXcGcmRdA3lPr",
    "TURNSTILE_EXPECTED_HOSTNAMES": "mohamednhafez.com,www.mohamednhafez.com,mohamed-hafez-portfolio.mohamed-m-nader555.workers.dev",
    // "ledger" runs the Gemini writer and checker; "classic" runs the earlier
    // Workers AI pipeline untouched. GEMINI_API_KEY is a Worker secret.
    "ASSISTANT_MODE": "ledger",
    "GEMINI_WRITER_MODEL": "gemini-3.8-flash",
    "GEMINI_CHECKER_MODEL": "gemini-3.5-flash-lite",
    // Measured 10 Oct 2026: medium thinking took about 10 s a question and
    // often passed the writer's 12 s limit; low takes about 4 s.
    "GEMINI_WRITER_THINKING": "low",
    // Brief 3, section 0a: 20 model-backed questions a day.
    "DAILY_MODEL_QUESTION_CAP": "20",
  },
  "kv_namespaces": [
    {
      "binding": "CHAT_BUDGET",
      "id": "a21f58f6ab884952bc9637cfeba3e962",
    },
  ],
  "ratelimits": [
    {
      "name": "CHAT_SESSION_RATE_LIMITER",
      "namespace_id": "10001",
      "simple": { "limit": 5, "period": 60 },
    },
    {
      "name": "CHAT_GLOBAL_RATE_LIMITER",
      "namespace_id": "10002",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
}
