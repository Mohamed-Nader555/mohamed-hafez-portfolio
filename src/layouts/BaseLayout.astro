---
import Footer from '@/components/layout/Footer.astro';
import Header from '@/components/layout/Header.astro';
import Seo from '@/components/layout/Seo.astro';
import type { StructuredDataNode } from '@/lib/seo/structured-data';
import type { RoleId } from '@/types/content';
import '@/styles/tokens.css';
import '@/styles/reset.css';
import '@/styles/global.css';
import '@/styles/components.css';
import '@/styles/lenses.css';
import '@/styles/longform.css';
import '@/styles/motion.css';

interface Props {
  title: string;
  description: string;
  roleId: RoleId;
  openGraphType?: 'website' | 'article';
  structuredData?: readonly StructuredDataNode[];
}

const {
  title,
  description,
  roleId,
  openGraphType = 'website',
  structuredData = [],
} = Astro.props;
if (!Astro.site) throw new Error('Astro.site must be configured.');
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      openGraphType={openGraphType}
      structuredData={structuredData}
    />
  </head>
  <body>
    <div class="site-shell" data-shell>
      <a class="skip-link" href="#main-content">Skip to main content</a>
      <Header activeRole={roleId} />
      <main class="site-main" id="main-content" tabindex="-1">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
