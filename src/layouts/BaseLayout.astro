---
import Footer from '@/components/layout/Footer.astro';
import Header from '@/components/layout/Header.astro';
import Seo from '@/components/layout/Seo.astro';
import type { StructuredDataNode } from '@/lib/seo/structured-data';
import type { RoleId } from '@/types/content';
import { ClientRouter } from 'astro:transitions';
import '@/styles/tokens.css';
import '@/styles/reset.css';
import '@/styles/global.css';
import '@/styles/components.css';
import '@/styles/lenses.css';
import '@/styles/longform.css';
import '@/styles/motion.css';
import '@/styles/profile.css';

interface Props {
  title: string;
  description: string;
  roleId: RoleId;
  openGraphType?: 'website' | 'article';
  structuredData?: readonly StructuredDataNode[];
}

const {
  title,
  description,
  roleId,
  openGraphType = 'website',
  structuredData = [],
} = Astro.props;
if (!Astro.site) throw new Error('Astro.site must be configured.');
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      openGraphType={openGraphType}
      structuredData={structuredData}
    />
    <ClientRouter />
  </head>
  <body>
    <div class="ambient-background" aria-hidden="true"></div>
    <div class="site-shell" data-shell data-active-role={roleId}>
      <a class="skip-link" href="#main-content">Skip to main content</a>
      <Header />
      <main class="site-main" id="main-content" tabindex="-1">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<script>
  import { installRoleNavigation } from '@/lib/client/role-navigation';

  function prepareReveals() {
    const elements = document.querySelectorAll(
      '.section-heading, .story-card--featured, .case-study-card, .experience-records article, .depth-grid article, .responsibility-groups article, .career-timeline article, .skills-grid article, .teaching-cards article, .education-grid article, .project-library__grid article, .research-stat-grid article, .research-chart-grid figure',
    );
    const reducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    ).matches;

    if (reducedMotion || !('IntersectionObserver' in window)) {
      elements.forEach((element) => element.classList.add('is-visible'));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
    );

    elements.forEach((element) => {
      element.classList.add('reveal-on-scroll');
      observer.observe(element);
    });
  }

  let persistentRoleFrame = 0;
  function updatePersistentRoleSwitcher() {
    cancelAnimationFrame(persistentRoleFrame);
    persistentRoleFrame = requestAnimationFrame(() => {
      const switcher = document.querySelector<HTMLElement>(
        '[data-persistent-role-switcher]',
      );
      const heroNavigation = document.querySelector<HTMLElement>(
        '[data-role-content] .lens-hero .recruiter-lens-nav',
      );
      if (!switcher || !heroNavigation) return;

      const headerBottom =
        document.querySelector('.site-header')?.getBoundingClientRect()
          .bottom ?? 0;
      const visible =
        heroNavigation.getBoundingClientRect().bottom <= headerBottom;
      switcher.classList.toggle('is-visible', visible);
      switcher.setAttribute('aria-hidden', visible ? 'false' : 'true');
      switcher.inert = !visible;
    });
  }

  document.addEventListener('astro:page-load', prepareReveals);
  document.addEventListener('portfolio:content-updated', prepareReveals);
  document.addEventListener(
    'portfolio:content-updated',
    updatePersistentRoleSwitcher,
  );
  window.addEventListener('scroll', updatePersistentRoleSwitcher, {
    passive: true,
  });
  window.addEventListener('resize', updatePersistentRoleSwitcher, {
    passive: true,
  });
  prepareReveals();
  updatePersistentRoleSwitcher();
  installRoleNavigation();

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let pointerFrame = 0;
    window.addEventListener(
      'pointermove',
      (event) => {
        cancelAnimationFrame(pointerFrame);
        pointerFrame = requestAnimationFrame(() => {
          document.documentElement.style.setProperty(
            '--pointer-x',
            `${event.clientX}px`,
          );
          document.documentElement.style.setProperty(
            '--pointer-y',
            `${event.clientY}px`,
          );
          document.documentElement.style.setProperty(
            '--pointer-shift-x',
            `${(event.clientX / window.innerWidth - 0.5) * 10}px`,
          );
          document.documentElement.style.setProperty(
            '--pointer-shift-y',
            `${(event.clientY / window.innerHeight - 0.5) * 8}px`,
          );
        });
      },
      { passive: true },
    );
  }
</script>
