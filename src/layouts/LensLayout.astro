---
import ContactSection from '@/components/sections/ContactSection.astro';
import EvidencePanel from '@/components/sections/EvidencePanel.astro';
import ExperienceSection from '@/components/sections/ExperienceSection.astro';
import FeaturedWork from '@/components/sections/FeaturedWork.astro';
import Hero from '@/components/sections/Hero.astro';
import TeachingSection from '@/components/sections/TeachingSection.astro';
import { PortfolioAssistant } from '@/components/ai/PortfolioAssistant';
import { roles, screeningFacts } from '@/data';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { resolveLens } from '@/lib/content/resolve-lens';
import type { RoleId } from '@/types/content';

interface Props {
  roleId: RoleId;
}

const { roleId } = Astro.props;
const lens = resolveLens(roleId);
const breadthLabels = roles
  .filter((role) => role.id !== roleId)
  .map((role) => role.label);
const preferredSourceId = `resume-${roleId}`;
const turnstileSiteKey =
  import.meta.env.PUBLIC_TURNSTILE_SITEKEY ?? '1x00000000000000000000AA';
---

<BaseLayout
  title={lens.title}
  description={lens.description}
  roleId={lens.roleId}
>
  <Hero lens={lens} breadthLabels={breadthLabels} />
  <EvidencePanel facts={screeningFacts} preferredSourceId={preferredSourceId} />
  <FeaturedWork projects={lens.projects} />
  <ExperienceSection lens={lens} />
  <TeachingSection lens={lens} />
  <ContactSection />
  <PortfolioAssistant
    client:load
    activeRole={roleId}
    initialSuggestions={[
      'How was Northstar built?',
      'What technologies did Mohamed use in Dostava?',
      'Where is Mohamed located and when can he start?',
    ]}
    turnstileSiteKey={turnstileSiteKey}
  />
</BaseLayout>
