---
import ContactSection from '@/components/sections/ContactSection.astro';
import EducationCredentials from '@/components/sections/EducationCredentials.astro';
import PersistentRoleSwitcher from '@/components/layout/PersistentRoleSwitcher.astro';
import TeachingPortfolio from '@/components/sections/TeachingPortfolio.astro';
import RoleContent from '@/components/lenses/RoleContent.astro';
import { PortfolioAssistant } from '@/components/ai/PortfolioAssistant';
import { roles } from '@/data';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { resolveLens } from '@/lib/content/resolve-lens';
import type { RoleId } from '@/types/content';

interface Props {
  roleId: RoleId;
}

const { roleId } = Astro.props;
const lens = resolveLens(roleId);
const turnstileSiteKey =
  import.meta.env.PUBLIC_TURNSTILE_SITEKEY ?? '1x00000000000000000000AA';
---

<BaseLayout
  title={lens.title}
  description={lens.description}
  roleId={lens.roleId}
>
  <RoleContent roleId={roleId} />
  <PersistentRoleSwitcher activeRole={roleId} />
  {
    roles.map((role) => (
      <template data-role-template={role.id}>
        <RoleContent roleId={role.id} />
      </template>
    ))
  }
  <TeachingPortfolio />
  <EducationCredentials />
  <ContactSection />
  <PortfolioAssistant
    client:load
    activeRole={roleId}
    initialSuggestions={[
      'How was Northstar built?',
      'What technologies did Mohamed use in Dostava?',
      'Where is Mohamed located and when can he start?',
    ]}
    turnstileSiteKey={turnstileSiteKey}
  />
</BaseLayout>
