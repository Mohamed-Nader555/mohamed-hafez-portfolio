---
import { profile } from '@/data/profile';

const year = new Date().getUTCFullYear();
---

<footer class="site-footer" id="contact">
  <div class="footer-inner shell-container">
    <div>
      <h2 class="footer-title">Continue the conversation directly.</h2>
      <p class="footer-copy">
        Mohamed is based in Toronto and immediately available for engineering
        opportunities in Canada.
      </p>
    </div>

    <nav class="footer-links" aria-label="Contact and profiles">
      <a href={`mailto:${profile.contacts.email}`}>Email</a>
      <a href={`tel:${profile.contacts.phone.replace(/\s/g, '')}`}>Phone</a>
      <a href={profile.contacts.linkedIn}>LinkedIn</a>
      <a href={profile.contacts.github}>GitHub</a>
      <a href="/privacy">Privacy</a>
    </nav>

    <p class="footer-meta">
      © {year} Mohamed Hafez · Evidence-led portfolio
    </p>
  </div>
</footer>
