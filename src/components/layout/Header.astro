---
import { profile } from '@/data/profile';
---

<header class="site-header">
  <div class="shell-container">
    <div class="header-console">
      <div class="header-bar">
        <a class="site-identity" href="/" aria-label="Mohamed Hafez, home">
          <span class="identity-monogram" aria-hidden="true">MH</span>
          <span class="identity-copy">
            <span class="identity-name">Mohamed Hafez</span>
            <span class="identity-subtitle">AI · software · mobile</span>
          </span>
        </a>

        <nav class="primary-nav primary-nav--desktop" aria-label="Primary">
          <a href="/work" data-astro-prefetch="viewport">Work</a>
          <a href="/research/asc-pie" data-astro-prefetch="viewport">Research</a
          >
          <a href="/#career-title" data-astro-prefetch="viewport">Experience</a>
          <a href="/#profile-summary-title" data-astro-prefetch="viewport"
            >About</a
          >
          <a class="primary-contact" href={`mailto:${profile.contacts.email}`}>
            Contact
          </a>
        </nav>

        <details class="site-menu">
          <summary>Explore</summary>
          <nav class="primary-nav primary-nav--compact" aria-label="Primary">
            <a href="/work" data-astro-prefetch="viewport">Work</a>
            <a href="/research/asc-pie" data-astro-prefetch="viewport"
              >Research</a
            >
            <a href="/#career-title" data-astro-prefetch="viewport"
              >Experience</a
            >
            <a href="/#profile-summary-title" data-astro-prefetch="viewport"
              >About</a
            >
            <a
              class="primary-contact"
              href={`mailto:${profile.contacts.email}`}
            >
              Contact
            </a>
          </nav>
        </details>
      </div>
    </div>
  </div>
</header>
