---
import {
  createPersonStructuredData,
  createStructuredDataGraph,
  type StructuredDataNode,
} from '@/lib/seo/structured-data';

interface Props {
  title: string;
  description: string;
  canonicalUrl: URL;
  openGraphType?: 'website' | 'article';
  structuredData?: readonly StructuredDataNode[];
}

const {
  title,
  description,
  canonicalUrl,
  openGraphType = 'website',
  structuredData = [],
} = Astro.props;
if (!Astro.site) throw new Error('Astro.site must be configured.');

const imageUrl = new URL('/og/mohamed-hafez-portfolio.svg', Astro.site);
const graph = createStructuredDataGraph(
  createPersonStructuredData(Astro.site),
  ...structuredData,
);
const serializedGraph = JSON.stringify(graph).replaceAll('<', '\\u003c');
---

<meta name="description" content={description} />
<meta name="author" content="Mohamed Hafez" />
<meta name="robots" content="index, follow" />
<meta name="theme-color" content="#050817" />
<link rel="canonical" href={canonicalUrl} />

<meta property="og:type" content={openGraphType} />
<meta property="og:site_name" content="Mohamed Hafez" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:type" content="image/svg+xml" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta
  property="og:image:alt"
  content="Mohamed Hafez — AI, software, and mobile engineering portfolio"
/>

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta
  name="twitter:image:alt"
  content="Mohamed Hafez — AI, software, and mobile engineering portfolio"
/>

<script is:inline type="application/ld+json" set:html={serializedGraph} />
<title>{title}</title>
