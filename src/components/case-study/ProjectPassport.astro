---
interface Props {
  role: string;
  context: string;
  period?: string;
  status: string;
  platform?: string;
}

const { role, context, period, status, platform } = Astro.props;
---

<dl class="project-passport">
  <div>
    <dt>My role</dt>
    <dd>{role}</dd>
  </div>
  <div>
    <dt>Context</dt>
    <dd>{context}</dd>
  </div>
  {
    period && (
      <div>
        <dt>Period</dt>
        <dd>{period}</dd>
      </div>
    )
  }
  <div>
    <dt>Status</dt>
    <dd>{status}</dd>
  </div>
  {
    platform && (
      <div>
        <dt>Platform</dt>
        <dd>{platform}</dd>
      </div>
    )
  }
</dl>

<style>
  .project-passport {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4) var(--space-6);
    margin: 0;
    padding: var(--space-5) var(--space-6);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--color-ink-850) 82%, transparent);
    backdrop-filter: blur(0.6rem);
  }

  .project-passport dt {
    font-family: var(--font-utility);
    font-size: var(--type-xs);
    letter-spacing: var(--tracking-utility);
    text-transform: uppercase;
    color: var(--color-evidence-300);
    margin-bottom: var(--space-1);
  }

  .project-passport dd {
    margin: 0;
    color: var(--color-ink-100);
    font-size: var(--type-sm);
    line-height: var(--leading-body);
  }

  @media (max-width: 56rem) {
    .project-passport {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 40rem) {
    .project-passport {
      grid-template-columns: 1fr;
    }
  }
</style>
