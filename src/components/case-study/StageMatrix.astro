---
interface Props {
  strategies: readonly string[];
  stageLabels: readonly string[];
  /** matrices[strategy][row][col] = F1 value (0-1) for that stage pair. */
  matrices: Readonly<Record<string, readonly (readonly number[])[]>>;
  title: string;
}

const { strategies, stageLabels, matrices, title } = Astro.props;

// Sequential single-hue scale on the cyan token, per §5.4, in 21 steps. The
// fill is a CSS class (heat-0 .. heat-20), not an inline style, because the
// site's CSP (style-src 'self') blocks style="..." attributes. Steps above 10
// (value > 0.5) use dark text for WCAG AA contrast on the bright cyan fill.
function heatClass(value: number) {
  const step = Math.min(20, Math.max(0, Math.round(value * 20)));
  return `heat-${step}`;
}
---

<div class="stage-matrix">
  <p class="utility-label">{title}</p>
  {
    strategies.map((strategy, index) => (
      <details class="stage-matrix__strategy" open={index === 0}>
        <summary>{strategy}</summary>
        <table>
          <caption class="visually-hidden">
            {strategy} stage-restricted F1
          </caption>
          <thead>
            <tr>
              <th scope="col" />
              {stageLabels.map((label) => (
                <th scope="col">{label}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {matrices[strategy]?.map((row, rowIndex) => (
              <tr>
                <th scope="row">{stageLabels[rowIndex]}</th>
                {row.map((value) => (
                  <td class={heatClass(value)}>{value.toFixed(2)}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </details>
    ))
  }
</div>

<style>
