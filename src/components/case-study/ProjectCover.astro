---
import { architectures } from '@/data/architectures';

interface Props {
  slug: string;
  group?: 'research' | 'ml' | 'android' | 'backend' | 'early';
}

const { slug, group } = Astro.props;

function hashSeed(input: string) {
  let hash = 2166136261;
  for (let i = 0; i < input.length; i += 1) {
    hash ^= input.charCodeAt(i);
    hash = Math.imul(hash, 16777619);
  }
  return hash >>> 0;
}

function mulberry32(seed: number) {
  let a = seed;
  return () => {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const color =
  group === 'research' || group === 'ml'
    ? 'var(--color-ai-500)'
    : group === 'early'
      ? 'var(--color-verified-500)'
      : 'var(--color-evidence-500)';

const nodeCount = Math.max(architectures[slug]?.nodes.length ?? 6, 5);
const random = mulberry32(hashSeed(slug));
const width = 320;
const height = 200;

const points = Array.from({ length: nodeCount }, () => ({
  x: 24 + random() * (width - 48),
  y: 24 + random() * (height - 48),
  r: 2.5 + random() * 3.5,
}));

const edges: { x1: number; y1: number; x2: number; y2: number }[] = [];
for (let i = 0; i < points.length; i += 1) {
  const next = points[(i + 1) % points.length];
  const current = points[i];
  edges.push({ x1: current.x, y1: current.y, x2: next.x, y2: next.y });
}
---

<svg
  class="project-cover"
  viewBox={`0 0 ${width} ${height}`}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
  xmlns="http://www.w3.org/2000/svg"
>
  <rect width={width} height={height} fill="var(--color-ink-950)"></rect>
  {
    edges.map((edge) => (
      <line
        x1={edge.x1}
        y1={edge.y1}
        x2={edge.x2}
        y2={edge.y2}
        stroke={color}
        stroke-opacity="0.35"
        stroke-width="1"
      />
    ))
  }
  {
    points.map((point) => (
      <circle
        cx={point.x}
        cy={point.y}
        r={point.r}
        fill={color}
        fill-opacity="0.85"
      />
    ))
  }
</svg>

<style>
  .project-cover {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    border-radius: var(--radius-md);
  }
</style>
