---
import { projects } from '@/data';
import { resolveRepoDisplay } from '@/data/repos';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const project = projects.find((candidate) => candidate.slug === slug);

if (!project) {
  throw new Error(`RepositoryLinks: unknown project ${slug}`);
}

const display = resolveRepoDisplay(project.repos);
---

{
  (display.links.length > 0 || display.comingSoon) && (
    <ul class="repo-links">
      {display.links.map((link) => (
        <li>
          <a href={link.href} rel="noopener">
            {link.label} <span aria-hidden="true">&#8599;</span>
          </a>
        </li>
      ))}
      {display.comingSoon && (
        <li>
          <span class="repo-chip" aria-disabled="true">
            Code: coming soon
          </span>
        </li>
      )}
    </ul>
  )
}

<style>
  .repo-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: var(--space-3) 0;
    padding: 0;
    list-style: none;
  }

  .repo-links a {
    color: var(--color-evidence-300);
    font-weight: 700;
  }

  .repo-chip {
    display: inline-flex;
    padding: var(--space-1) var(--space-3);
    border: 1px dashed var(--border-subtle);
    border-radius: 999px;
    color: var(--color-ink-300);
    font-family: var(--font-utility);
    font-size: var(--type-xs);
    cursor: not-allowed;
  }
</style>
