---
import ProjectCover from '@/components/case-study/ProjectCover.astro';
import StatusBadge from '@/components/case-study/StatusBadge.astro';
import type { StatusKey } from '@/data/project-status';
import type { ProjectRecord } from '@/types/content';

interface KeyFact {
  value: string;
  label: string;
}

interface Props {
  project: ProjectRecord;
  keyFacts?: readonly KeyFact[];
}

const { project, keyFacts } = Astro.props;
---

<article class="flagship-card" data-focus={project.roles.join(' ')}>
  <div class="flagship-card__visual" aria-hidden="true">
    <ProjectCover slug={project.slug} group={project.group} />
  </div>
  <div class="flagship-card__body">
    <p class="utility-label">{project.category}</p>
    <h3 transition:name={`project-title-${project.slug}`}>{project.title}</h3>
    <p class="flagship-card__hook">{project.hook}</p>
    {
      keyFacts && keyFacts.length > 0 && (
        <ul class="flagship-card__facts">
          {keyFacts.map((fact) => (
            <li>
              <strong>{fact.value}</strong>
              <span>{fact.label}</span>
            </li>
          ))}
        </ul>
      )
    }
    <ul class="technology-list" aria-label={`${project.title} technologies`}>
      {project.technologies.slice(0, 5).map((technology) => <li>{technology}</li>)}
    </ul>
    {project.status && <StatusBadge status={project.status as StatusKey} showLonger={false} />}
    <a href={`/work/${project.slug}`} data-astro-prefetch="viewport" class="flagship-card__cta">
      Read the story <span aria-hidden="true">→</span>
    </a>
  </div>
</article>

<style>
  .flagship-card {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: var(--space-5);
    padding: var(--space-5);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--color-ink-900) 75%, transparent);
    position: relative;
    overflow: hidden;
  }

  .flagship-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(
      120deg,
      var(--color-evidence-500),
      transparent 40%,
      var(--color-ai-500)
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0.3;
    pointer-events: none;
  }

  .flagship-card__visual {
    aspect-ratio: 8 / 5;
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .flagship-card__hook {
    font-family: var(--font-display);
    color: var(--color-ink-100);
    font-size: var(--type-body);
    margin: var(--space-1) 0 var(--space-3);
  }

  .flagship-card__facts {
    display: flex;
    gap: var(--space-4);
    padding: 0;
    margin: 0 0 var(--space-3);
    list-style: none;
  }

  .flagship-card__facts strong {
    display: block;
    font-family: var(--font-display);
    color: var(--color-evidence-300);
  }

  .flagship-card__facts span {
    font-size: var(--type-xs);
    color: var(--color-ink-300);
  }

  .flagship-card__cta {
    display: inline-block;
    margin-top: var(--space-3);
    color: var(--color-evidence-300);
    text-decoration: none;
    font-size: var(--type-sm);
  }

  @media (max-width: 45rem) {
    .flagship-card {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flagship-card::before {
      display: none;
    }
  }
</style>
