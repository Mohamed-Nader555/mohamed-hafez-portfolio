---
import { roles } from '@/data';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'caseStudies'>;
  index: number;
}

const { entry, index } = Astro.props;
const roleById = new Map(roles.map((role) => [role.id, role.label]));
---

<article class="case-study-card">
  <p class="case-study-card__index" aria-hidden="true">
    {String(index + 1).padStart(2, '0')}
  </p>
  <div class="case-study-card__body">
    <p class="utility-label">
      {entry.data.roles.map((role) => roleById.get(role)).join(' · ')}
    </p>
    <h2>{entry.data.title}</h2>
    <p>{entry.data.summary}</p>
    <p class="case-study-card__ownership">
      <strong>Owned:</strong>{' '}{entry.data.ownership}
    </p>
    <ul class="technology-list" aria-label={`${entry.data.title} technologies`}>
      {
        entry.data.technologies
          .slice(0, 5)
          .map((technology) => <li>{technology}</li>)
      }
    </ul>
    <a
      class="project-card__link"
      href={`/work/${entry.data.slug}`}
      aria-label={`Read ${entry.data.title} case study`}
    >
      Read case study <span aria-hidden="true">→</span>
    </a>
  </div>
</article>
