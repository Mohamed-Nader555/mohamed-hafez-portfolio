---
import { architectures, type ArchitectureSlug } from '@/data/architectures';

interface Props {
  slug: ArchitectureSlug;
  title: string;
}

const { slug, title } = Astro.props;
const architecture = architectures[slug];

if (!architecture) {
  throw new Error(`Missing architecture definition for ${slug}`);
}

const nodeById = new Map(
  architecture.nodes.map((node) => [node.id, node] as const),
);

if (nodeById.size !== architecture.nodes.length) {
  throw new Error(`Duplicate architecture node for ${slug}`);
}

const relationships = architecture.edges.map((edge) => {
  const from = nodeById.get(edge.from);
  const to = nodeById.get(edge.to);

  if (!from || !to) {
    throw new Error(
      `Architecture edge ${edge.from} -> ${edge.to} references a missing node for ${slug}`,
    );
  }

  return { edge, from, to };
});

const relationshipText = relationships
  .map(({ edge, from, to }) =>
    edge.label
      ? `${from.label} to ${to.label} (${edge.label})`
      : `${from.label} to ${to.label}`,
  )
  .join('; ');

const pipeline =
  architecture.pipeline ?? architecture.nodes.map((node) => node.label);
---

<figure
  class="architecture-flow"
  aria-label={`${title} architecture`}
  aria-describedby={`${slug}-architecture-summary`}
>
  <p class="architecture-flow__label" aria-hidden="true">Flow</p>
  <ol class="architecture-flow__pipeline" aria-hidden="true">
    {
      pipeline.map((stage) => (
        <li>
          <code>{stage}</code>
        </li>
      ))
    }
  </ol>
  <p class="architecture-flow__label" aria-hidden="true">Components</p>
  <ol class="architecture-flow__nodes" aria-hidden="true">
    {
      architecture.nodes.map((node, index) => (
        <li data-node-id={node.id}>
          <span class="architecture-flow__node-index">
            {String(index + 1).padStart(2, '0')}
          </span>
          <strong>{node.label}</strong>
          <small>{node.detail}</small>
        </li>
      ))
    }
  </ol>
  <p class="architecture-flow__label" aria-hidden="true">Connections</p>
  <ul class="architecture-flow__edges" aria-hidden="true">
    {
      relationships.map(({ edge, from, to }) => (
        <li data-edge-from={edge.from} data-edge-to={edge.to}>
          <span>{from.label}</span>
          <span class="architecture-flow__arrow" aria-hidden="true">
            {edge.label && <em>{edge.label}</em>}→
          </span>
          <span>{to.label}</span>
        </li>
      ))
    }
  </ul>
  <figcaption id={`${slug}-architecture-summary`}>
    {architecture.summary}
    <span class="visually-hidden"> Relationships: {relationshipText}.</span>
  </figcaption>
</figure>

<style>
  .architecture-flow {
    max-inline-size: none;
    margin: var(--space-6) 0 var(--space-8);
    padding: clamp(var(--space-4), 3vw, var(--space-6));
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--color-ink-800) 65%, transparent),
      color-mix(in srgb, var(--color-ink-900) 84%, transparent)
    );
    box-shadow: var(--shadow-surface);
  }

  .architecture-flow__label {
    margin: var(--space-6) 0 var(--space-3);
    color: var(--color-ink-300);
    font-family: var(--font-utility);
    font-size: var(--type-xs);
    line-height: 1.2;
    letter-spacing: var(--tracking-utility);
    text-transform: uppercase;
  }

  .architecture-flow__label:first-child {
    margin-block-start: 0;
  }

  .architecture-flow__pipeline,
  .architecture-flow__nodes,
  .architecture-flow__edges {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .architecture-flow__pipeline li,
  .architecture-flow__nodes li,
  .architecture-flow__edges li {
    margin: 0;
  }

  /* Pipeline strip: monospace stage chips joined by arrows. */
  .architecture-flow__pipeline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .architecture-flow__pipeline li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .architecture-flow__pipeline li + li::before {
    content: '→';
    color: var(--color-evidence-500);
    font-family: var(--font-utility);
    font-size: var(--type-sm);
  }

  .architecture-flow__pipeline code {
    padding: 0.3rem 0.7rem;
    border: 1px solid
      color-mix(in srgb, var(--color-evidence-500) 45%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-evidence-500) 10%, transparent);
    color: var(--color-evidence-300);
    font-family: var(--font-utility);
    font-size: var(--type-xs);
    line-height: 1.3;
    white-space: nowrap;
  }

  /* Component cards. */
  .architecture-flow__nodes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 10.5rem), 1fr));
    gap: var(--space-3);
  }

  .architecture-flow__nodes li {
    display: grid;
    min-inline-size: 0;
    align-content: start;
    gap: var(--space-2);
    padding: var(--space-4);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-ink-850) 70%, transparent);
  }

  .architecture-flow__node-index {
    color: var(--color-ai-300);
    font-family: var(--font-utility);
    font-size: var(--type-xs);
    line-height: 1;
  }

  .architecture-flow__nodes strong {
    color: var(--color-ink-100);
    font-family: var(--font-display);
    font-size: var(--type-sm);
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .architecture-flow__nodes small {
    color: var(--color-ink-300);
    font-size: var(--type-xs);
    line-height: 1.45;
  }

  /* Connections: one compact "from -> to" row per edge. */
  .architecture-flow__edges {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-2);
  }

  .architecture-flow__edges li {
    display: grid;
    min-inline-size: 0;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: var(--space-3);
    align-items: center;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    color: var(--color-ink-200);
    font-size: var(--type-xs);
    line-height: 1.4;
  }

  .architecture-flow__edges li > span {
    min-inline-size: 0;
    overflow-wrap: anywhere;
  }

  .architecture-flow__edges li > span:last-child {
    text-align: end;
  }

  .architecture-flow__arrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-evidence-500);
    font-family: var(--font-utility);
    white-space: nowrap;
  }

  .architecture-flow__arrow em {
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-ai-500) 14%, transparent);
    color: var(--color-ai-300);
    font-size: 0.68rem;
    font-style: normal;
  }

  .architecture-flow figcaption {
    margin-block-start: var(--space-6);
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--border-subtle);
    color: var(--color-ink-200);
    font-size: var(--type-sm);
    line-height: var(--leading-body);
  }

  @media (max-width: 22.5rem) {
    .architecture-flow__pipeline code {
      white-space: normal;
    }

    .architecture-flow__edges li {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }

    .architecture-flow__edges li > span:last-child {
      text-align: start;
    }
  }
</style>
