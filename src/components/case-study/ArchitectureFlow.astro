---
import { architectures, type ArchitectureSlug } from '@/data/architectures';

interface Props {
  slug: ArchitectureSlug;
  title: string;
}

const { slug, title } = Astro.props;
const architecture = architectures[slug];

if (!architecture) {
  throw new Error(`Missing architecture definition for ${slug}`);
}

const nodeById = new Map(
  architecture.nodes.map((node) => [node.id, node] as const),
);
const indexById = new Map(
  architecture.nodes.map((node, index) => [node.id, index] as const),
);

if (nodeById.size !== architecture.nodes.length) {
  throw new Error(`Duplicate architecture node for ${slug}`);
}

const relationships = architecture.edges.map((edge) => {
  const from = nodeById.get(edge.from);
  const to = nodeById.get(edge.to);

  if (!from || !to) {
    throw new Error(
      `Architecture edge ${edge.from} -> ${edge.to} references a missing node for ${slug}`,
    );
  }

  return { edge, from, to };
});

const relationshipText = relationships
  .map(({ edge, from, to }) =>
    edge.label
      ? `${from.label} to ${to.label} (${edge.label})`
      : `${from.label} to ${to.label}`,
  )
  .join('; ');

// Each relationship is shown once, on the cards themselves. An unlabelled edge
// to the very next card is a connector (an arrow in the gap after the source
// card); every other edge (a branch, a skip, a loop back, or anything with a
// label) is a link chip in the source card's footer.
const connectorFrom = new Map<string, string>();
const chipsFrom = new Map<string, typeof relationships>();
for (const relationship of relationships) {
  const { edge } = relationship;
  const isNext =
    !edge.label &&
    !connectorFrom.has(edge.from) &&
    indexById.get(edge.to) === (indexById.get(edge.from) ?? -2) + 1;
  if (isNext) connectorFrom.set(edge.from, edge.to);
  else
    chipsFrom.set(edge.from, [
      ...(chipsFrom.get(edge.from) ?? []),
      relationship,
    ]);
}
// A graph is linear when every edge is a connector: the connected cards
// already are the pipeline, so the Flow strip would only repeat them.
const linear = chipsFrom.size === 0;

const pipeline =
  architecture.pipeline ?? architecture.nodes.map((node) => node.label);
---

<figure
  class="architecture-flow"
  aria-label={`${title} architecture`}
  aria-describedby={`${slug}-architecture-summary`}
>
  {
    !linear && (
      <>
        <p class="architecture-flow__label" aria-hidden="true">
          Main path
        </p>
        <ol class="architecture-flow__pipeline" aria-hidden="true">
          {pipeline.map((stage) => (
            <li>
              <code>{stage}</code>
            </li>
          ))}
        </ol>
      </>
    )
  }
  <p class="architecture-flow__label" aria-hidden="true">
    {linear ? 'Pipeline, step by step' : 'Components and what they talk to'}
  </p>
  <ol class="architecture-flow__nodes" aria-hidden="true">
    {
      architecture.nodes.map((node, index) => (
        <li data-node-id={node.id} data-next={connectorFrom.get(node.id)}>
          <span class="architecture-flow__node-index">
            {String(index + 1).padStart(2, '0')}
          </span>
          <strong>{node.label}</strong>
          <small>{node.detail}</small>
          {chipsFrom.has(node.id) && (
            <ul class="architecture-flow__links" aria-label="Sends to">
              {chipsFrom.get(node.id)!.map(({ edge, to }) => (
                <li data-edge-from={edge.from} data-edge-to={edge.to}>
                  <span aria-hidden="true">→</span> {to.label}
                  {edge.label && <em>{edge.label}</em>}
                </li>
              ))}
            </ul>
          )}
        </li>
      ))
    }
  </ol>
  <figcaption id={`${slug}-architecture-summary`}>
    {architecture.summary}
    <span class="visually-hidden"> Relationships: {relationshipText}.</span>
  </figcaption>
</figure>

<style>
  .architecture-flow {
    max-inline-size: none;
    margin: var(--space-6) 0 var(--space-8);
    padding: clamp(var(--space-4), 3vw, var(--space-6));
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--color-ink-800) 65%, transparent),
      color-mix(in srgb, var(--color-ink-900) 84%, transparent)
    );
    box-shadow: var(--shadow-surface);
  }

  .architecture-flow__label {
    margin: var(--space-6) 0 var(--space-3);
    color: var(--color-ink-300);
    font-family: var(--font-utility);
    font-size: var(--type-xs);
    line-height: 1.2;
    letter-spacing: var(--tracking-utility);
    text-transform: uppercase;
  }

  .architecture-flow__label:first-child {
    margin-block-start: 0;
  }

  .architecture-flow__pipeline,
  .architecture-flow__nodes,
  .architecture-flow__links {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .architecture-flow__pipeline li,
  .architecture-flow__nodes li {
    margin: 0;
  }

  /* Main path: monospace stage chips joined by arrows. */
  .architecture-flow__pipeline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .architecture-flow__pipeline li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .architecture-flow__pipeline li + li::before {
    content: '→';
    color: var(--color-evidence-500);
    font-family: var(--font-utility);
    font-size: var(--type-sm);
  }

  .architecture-flow__pipeline code {
    padding: 0.3rem 0.7rem;
    border: 1px solid
      color-mix(in srgb, var(--color-evidence-500) 45%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-evidence-500) 10%, transparent);
    color: var(--color-evidence-300);
    font-family: var(--font-utility);
    font-size: var(--type-xs);
    line-height: 1.3;
    white-space: nowrap;
  }

  /* Component cards, with a connector arrow in the gap after a card that
     leads straight to the next one. */
  .architecture-flow__nodes {
    --flow-gap: var(--space-5);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 10.5rem), 1fr));
    gap: var(--flow-gap);
    /* Room for the arrow after the last card of a row: it reads as "continues
       on the next row" and stays inside the list instead of overflowing. */
    padding-inline-end: var(--flow-gap);
  }

  .architecture-flow__nodes > li {
    position: relative;
    display: grid;
    min-inline-size: 0;
    align-content: start;
    gap: var(--space-2);
    padding: var(--space-4);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-ink-850) 70%, transparent);
  }

  .architecture-flow__nodes > li[data-next]::after {
    content: '→';
    position: absolute;
    inset-block-start: 50%;
    inset-inline-end: calc(var(--flow-gap) * -1);
    inline-size: var(--flow-gap);
    translate: 0 -50%;
    color: var(--color-evidence-500);
    font-family: var(--font-utility);
    text-align: center;
  }

  .architecture-flow__node-index {
    color: var(--color-ai-300);
    font-family: var(--font-utility);
    font-size: var(--type-xs);
    line-height: 1;
  }

  .architecture-flow__nodes strong {
    color: var(--color-ink-100);
    font-family: var(--font-display);
    font-size: var(--type-sm);
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .architecture-flow__nodes small {
    color: var(--color-ink-300);
    font-size: var(--type-xs);
    line-height: 1.45;
  }

  /* Link chips: where a card sends data besides the next card. */
  .architecture-flow__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
    margin: var(--space-2) 0 0;
    padding: var(--space-2) 0 0;
    border-block-start: 1px dashed var(--border-subtle);
  }

  .architecture-flow__links li {
    color: var(--color-evidence-300);
    font-family: var(--font-utility);
    font-size: 0.72rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .architecture-flow__links em {
    margin-inline-start: var(--space-1);
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-ai-500) 14%, transparent);
    color: var(--color-ai-300);
    font-size: 0.68rem;
    font-style: normal;
  }

  .architecture-flow figcaption {
    margin-block-start: var(--space-6);
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--border-subtle);
    color: var(--color-ink-200);
    font-size: var(--type-sm);
    line-height: var(--leading-body);
  }

  /* One column: cards stack, so connectors point down. */
  @media (max-width: 30rem) {
    .architecture-flow__nodes {
      grid-template-columns: 1fr;
      padding-inline-end: 0;
    }

    .architecture-flow__nodes > li[data-next]::after {
      content: '↓';
      display: grid;
      place-items: center;
      inset-block: auto calc(var(--flow-gap) * -1);
      inset-inline: 0;
      inline-size: auto;
      block-size: var(--flow-gap);
      translate: none;
    }
  }

  @media (max-width: 22.5rem) {
    .architecture-flow__pipeline code {
      white-space: normal;
    }
  }
</style>
