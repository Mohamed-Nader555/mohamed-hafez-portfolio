---
import { PROJECT_STATUS, type StatusKey } from '@/data/project-status';

interface Props {
  status: StatusKey;
  showLonger?: boolean;
}

const { status, showLonger = true } = Astro.props;
const definition = PROJECT_STATUS[status];
---

<p class="status-badge" role="group" aria-label="Project status">
  <span class="status-badge__pill">{definition.badge}</span>
  {showLonger && <span class="status-badge__longer">{definition.longer}</span>}
</p>

<style>
  .status-badge {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-3);
    margin: 0;
  }

  .status-badge__pill {
    display: inline-flex;
    align-items: center;
    padding: 0.3rem var(--space-3);
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-verified-500) 45%, transparent);
    background: color-mix(in srgb, var(--color-verified-500) 14%, transparent);
    color: var(--color-verified-500);
    font-family: var(--font-utility);
    font-size: var(--type-xs);
    letter-spacing: var(--tracking-utility);
    text-transform: uppercase;
  }

  .status-badge__longer {
    font-size: var(--type-sm);
    color: var(--color-ink-300);
  }
</style>
