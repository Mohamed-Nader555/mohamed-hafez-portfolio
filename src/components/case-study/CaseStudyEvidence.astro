---
import type { PublicSource } from '@/lib/content/resolve-sources';

interface Props {
  sources: readonly PublicSource[];
}

const { sources } = Astro.props;

if (sources.length === 0) {
  throw new Error(
    'A published case study requires at least one non-circular public source.',
  );
}
---

<aside
  class="case-study-evidence"
  role="region"
  aria-labelledby="public-evidence-title"
  aria-label="Public evidence"
>
  <div>
    <p class="utility-label">Verification desk</p>
    <h2 id="public-evidence-title">Public evidence</h2>
    <p>Open the records used to support this case study.</p>
  </div>
  <ul>
    {
      sources.map((source) => (
        <li>
          <a href={source.publicHref}>
            <span>{source.label}</span>
            <span aria-hidden="true">↗</span>
          </a>
        </li>
      ))
    }
  </ul>
</aside>
