---
interface ArchitectureStep {
  label: string;
  detail: string;
}

interface ArchitectureDefinition {
  summary: string;
  steps: readonly ArchitectureStep[];
}

interface Props {
  slug: keyof typeof architectures;
  title: string;
}

const architectures = {
  'asc-pie': {
    summary:
      'Privacy datasets move through preprocessing and shared PII labels before model training and named-entity recognition evaluation.',
    steps: [
      { label: 'Privacy datasets', detail: 'Real and synthetic text' },
      { label: 'Preprocessing', detail: 'Dataset-specific preparation' },
      { label: 'Shared PII labels', detail: 'Comparable representation' },
      { label: 'Model training', detail: 'Transformer experiments' },
      { label: 'NER evaluation', detail: 'Cross-dataset comparison' },
    ],
  },
  'northstar-rag': {
    summary:
      'Document sources are ingested and chunked, embedded locally, filtered through persistent retrieval, and supplied to grounded generation with citations or refusal.',
    steps: [
      { label: 'Document sources', detail: 'PDF, text, Markdown' },
      { label: 'Ingest + chunk', detail: 'Clean, overlapping passages' },
      { label: 'Local embeddings', detail: 'all-MiniLM-L6-v2' },
      { label: 'Chroma retrieval', detail: 'Distance-filtered evidence' },
      { label: 'Grounded answer', detail: 'Citations or fixed refusal' },
    ],
  },
  'minds-eye': {
    summary:
      'Wearable input reaches an Android client, which coordinates recognition services and converts OCR or vision results into spoken output.',
    steps: [
      { label: 'Wearable input', detail: 'Arduino-based device' },
      { label: 'Android client', detail: 'Java coordination layer' },
      { label: 'Recognition services', detail: 'REST and Retrofit' },
      { label: 'OCR / vision result', detail: 'Text and currency recognition' },
      { label: 'Speech output', detail: 'Accessible playback' },
    ],
  },
  dive: {
    summary:
      'The Android client coordinates the safety-classification API, Firebase data services, and location-aware planning services.',
    steps: [
      { label: 'Diver inputs', detail: 'Planning context' },
      { label: 'Android client', detail: 'Java mobile experience' },
      { label: 'Retrofit API', detail: 'Service boundary' },
      { label: 'Safety classifier', detail: 'Python + scikit-learn' },
      { label: 'Planning result', detail: 'Profile + recommendations' },
    ],
  },
  dostava: {
    summary:
      'The Android interface uses MVVM to coordinate remote APIs, local persistence, notifications, and map-based tracking.',
    steps: [
      { label: 'Android interface', detail: 'Java product workflow' },
      { label: 'MVVM', detail: 'Presentation boundary' },
      { label: 'Retrofit + Room', detail: 'Remote and local data' },
      { label: 'Firebase + Maps', detail: 'Notifications and location' },
      { label: 'Delivery state', detail: 'Orders and tracking' },
    ],
  },
} as const satisfies Record<string, ArchitectureDefinition>;

const { slug, title } = Astro.props;
const architecture = architectures[slug];

if (!architecture) {
  throw new Error(`Missing architecture definition for ${slug}`);
}
---

<figure
  class="architecture-diagram"
  aria-label={`${title} architecture`}
  aria-describedby={`${slug}-architecture-summary`}
>
  <ol aria-hidden="true">
    {
      architecture.steps.map((step, index) => (
        <li>
          <span class="architecture-diagram__step">
            {String(index + 1).padStart(2, '0')}
          </span>
          <strong>{step.label}</strong>
          <small>{step.detail}</small>
        </li>
      ))
    }
  </ol>
  <figcaption id={`${slug}-architecture-summary`}>
    {architecture.summary}
  </figcaption>
</figure>
