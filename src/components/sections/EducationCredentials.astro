---
import { awards, credentials, education } from '@/data/career';
---

<section
  class="education-section shell-container"
  aria-labelledby="education-title"
>
  <header class="section-heading">
    <p class="utility-label">Education, credentials, and recognition</p>
    <h2 id="education-title">The foundation behind my work</h2>
  </header>
  <div class="education-grid">
    {
      education.map((entry) => (
        <article>
          <p class="career-timeline__period">{entry.period}</p>
          <h3>{entry.credential}</h3>
          <p class="career-timeline__organization">{entry.institution}</p>
          <ul>
            {entry.details.map((detail) => (
              <li>{detail}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
  <div class="credentials-layout">
    <section aria-labelledby="credentials-title">
      <h3 id="credentials-title">Certificates and training</h3>
      <ul>
        {
          credentials.map(([title, meta]) => (
            <li>
              <>
                <span>{title}</span>
                <small>{meta}</small>
              </>
            </li>
          ))
        }
      </ul>
    </section>
    <section aria-labelledby="awards-title">
      <h3 id="awards-title">Awards and honours</h3>
      <ul>
        {
          awards.map(([title, meta]) => (
            <li>
              <>
                <span>{title}</span>
                <small>{meta}</small>
              </>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</section>
