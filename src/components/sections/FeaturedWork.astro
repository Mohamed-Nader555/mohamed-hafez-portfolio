---
import StoryCard from '@/components/case-study/StoryCard.astro';
import { keyFactsBySlug } from '@/data/key-facts';
import type { DeepReadonly } from '@/lib/content/resolve-lens';
import type { ProjectRecord } from '@/types/content';

interface Props {
  projects: readonly DeepReadonly<ProjectRecord>[];
}

const { projects } = Astro.props;

// Every featured card opens the project's story at /work/<slug>. The one
// featured project with no page, teaching, points at the teaching section
// further down this page instead.
const TEACHING_ANCHOR = '#teaching-portfolio';

function cardTarget(project: DeepReadonly<ProjectRecord>) {
  const hasPage = ['flagship', 'story', 'brief'].includes(project.detailLevel);
  return hasPage
    ? { href: `/work/${project.slug}`, linkLabel: 'Read the story' }
    : { href: TEACHING_ANCHOR, linkLabel: 'See how I teach' };
}
---

<section
  class="lens-section featured-section shell-container"
  aria-labelledby="featured-title"
>
  <header class="section-heading section-heading--split">
    <div>
      <p class="utility-label">Selected projects</p>
      <h2 id="featured-title">Work I’m proud of</h2>
    </div>
    <p>
      These are the four I would walk you through first for this kind of work.
      Each opens into the full story: the problem, what I built myself, and what
      I would change.
    </p>
  </header>

  <div class="project-grid featured-grid">
    {
      projects.slice(0, 4).map((project) => {
        const { href, linkLabel } = cardTarget(project);

        return (
          <StoryCard
            project={project}
            featured
            href={href}
            linkLabel={linkLabel}
            keyFacts={keyFactsBySlug[project.id]}
          />
        );
      })
    }
  </div>
</section>
