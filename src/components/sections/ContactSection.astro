---
import { profile } from '@/data';

const phoneHref = profile.contacts.phone.replace(/[^+\d]/g, '');
---

<section
  class="lens-section contact-section shell-container"
  aria-label="Direct contact"
>
  <div>
    <p class="utility-label">No form or scheduler</p>
    <h2 id="contact-title">Start a direct conversation</h2>
    <p>{profile.availability} · {profile.location}</p>
  </div>

  <nav class="contact-grid" aria-label="Direct contact options">
    <a href={`mailto:${profile.contacts.email}`}>
      <span>Email</span>
      <strong>{profile.contacts.email}</strong>
    </a>
    <a href={`tel:${phoneHref}`}>
      <span>Phone</span>
      <strong>{profile.contacts.phone}</strong>
    </a>
    <a href={profile.contacts.linkedIn}>
      <span>Professional profile</span>
      <strong>LinkedIn</strong>
    </a>
    <a href={profile.contacts.github}>
      <span>Public code profile</span>
      <strong>GitHub · {profile.githubHandle}</strong>
    </a>
  </nav>
</section>
