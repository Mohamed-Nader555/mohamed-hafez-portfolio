---
import ContactLinks from '@/components/layout/ContactLinks.astro';
import RecruiterLensNav from '@/components/layout/RecruiterLensNav.astro';
import ResumeLink from '@/components/layout/ResumeLink.astro';
import ProjectSpotlight from '@/components/sections/ProjectSpotlight.astro';
import { profile } from '@/data';
import { careerRoles } from '@/data/career';
import type { ResolvedLens } from '@/lib/content/resolve-lens';

interface Props {
  lens: ResolvedLens;
  breadthLabels: readonly string[];
}

const { lens, breadthLabels } = Astro.props;
const roleContent = careerRoles[lens.roleId];
---

<section
  class="lens-hero shell-container"
  aria-label={`${lens.label} overview`}
>
  <div class="lens-hero__copy">
    <RecruiterLensNav activeRole={lens.roleId} />
    <p class="utility-label lens-hero__role">{lens.label}</p>
    <h1 id="lens-title">
      <span>I’m Mohamed Hafez.</span>
      <span class="lens-hero__thesis">{roleContent.hero}</span>
    </h1>
    <p class="lens-hero__lead">
      <span class="entity-tag" data-entity="ROLE">{roleContent.eyebrow}</span>
      <span> · </span>
      <span class="entity-tag" data-entity="LOC">Toronto, Canada</span>
      <span> · </span>
      <span class="entity-tag entity-tag--magenta" data-entity="STATUS"
        >Open to new roles</span
      >
    </p>
    <p class="lens-hero__breadth">
      <span>I also work across</span>
      {breadthLabels.join(' · ')}
    </p>
    <div class="lens-actions">
      <ContactLinks
        ariaLabel="Contact me"
        channels={['email']}
        variant="action"
      />
      <ResumeLink
        href={lens.resumeHref}
        roleId={lens.roleId}
        roleLabel={lens.label}
      />
    </div>
  </div>

  <div class="lens-hero__aside">
    <ProjectSpotlight roleId={lens.roleId} />
    <aside class="lens-hero__context" aria-label="Availability and work status">
      <p class="context-signal">
        <span aria-hidden="true"></span>{profile.availability}
      </p>
      <dl>
        <div>
          <dt>Location</dt>
          <dd>{profile.location}</dd>
        </div>
        <div>
          <dt>Work authorization</dt>
          <dd>{profile.workAuthorization}</dd>
        </div>
        <div>
          <dt>Sponsorship</dt>
          <dd>{profile.sponsorship}</dd>
        </div>
      </dl>
    </aside>
  </div>
</section>
