---
import { modelFamilies } from '@/data/research-asc-pie';

const strategies = [
  ['SPRINT-PP', 83.5],
  ['Distillation', 83.0],
  ['Replay', 76.5],
  ['Baseline', 14.6],
] as const;
---

<section
  class="research-highlights shell-container"
  aria-labelledby="research-highlights-title"
>
  <header class="section-heading">
    <p class="utility-label">Research at a glance</p>
    <h2 id="research-highlights-title">
      A shared corpus, protocol, and reproducible benchmark
    </h2>
  </header>
  <div class="research-stat-grid">
    <article><span>Total examples</span><strong>333,109</strong></article>
    <article><span>Entity mentions</span><strong>2,025,878</strong></article>
    <article><span>Canonical PII types</span><strong>19</strong></article>
    <article><span>Corpus sources</span><strong>5</strong></article>
  </div>
  <div class="research-chart-grid">
    <figure>
      <figcaption>
        Supervised fine-tuning · strict F1 and output validity
      </figcaption>
      <div class="bar-chart bar-chart--validity">
        {
          modelFamilies.map((model) => (
            <div>
              <span>{model.label}</span>
              <i style={`--bar-value:${model.f1}%`} />
              <strong>{model.f1.toFixed(1)}%</strong>
              <small>validity {model.validity}</small>
            </div>
          ))
        }
      </div>
      <p>
        Validity is the share of generated outputs that follow the required
        structure. The four strongest models produce usable output every time.
        The decoder-only and BART-base models do not.
      </p>
    </figure>
    <figure>
      <figcaption>Continual-learning accuracy by strategy</figcaption>
      <div class="bar-chart bar-chart--magenta">
        {
          strategies.map(([label, value]) => (
            <div>
              <>
                <span>{label}</span>
                <i style={`--bar-value:${value}%`} />
                <strong>{value.toFixed(1)}%</strong>
              </>
            </div>
          ))
        }
      </div>
      <p>
        SPRINT-PP achieved the strongest tested accuracy while remaining
        privacy-safe and storing no raw historical PII.
      </p>
    </figure>
  </div>
</section>
