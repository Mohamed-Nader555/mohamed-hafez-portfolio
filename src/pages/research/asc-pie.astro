---
import ArchitectureFlow from '@/components/case-study/ArchitectureFlow.astro';
import ResearchHighlights from '@/components/research/ResearchHighlights.astro';
import { getEvidenceForProject } from '@/data';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { resolveSources } from '@/lib/content/resolve-sources';
import { createThesisStructuredData } from '@/lib/seo/structured-data';

export const prerender = true;

const ascPieRecords = getEvidenceForProject('asc-pie');
const sprintPpRecords = getEvidenceForProject('sprint-pp');
const recordById = new Map(
  [...ascPieRecords, ...sprintPpRecords].map((record) => [record.id, record]),
);
const titleRecord = recordById.get('asc-pie-thesis-title');
const degreeRecord = recordById.get('asc-pie-degree-awarded');
const statusRecord = recordById.get('sprint-pp-status');

if (!titleRecord || !degreeRecord || !statusRecord) {
  throw new Error(
    'ASC-PIE research page is missing required evidence records.',
  );
}

const thesisTitle = titleRecord.statement
  .match(/[“"](.+)[”"]/)?.[1]
  ?.replace(/\.$/, '');
if (!thesisTitle)
  throw new Error('Unable to derive the official thesis title.');

const officialSources = resolveSources([
  'official-yorkspace',
  'official-thesis-handle',
  'github-thesis-experiments',
]);
if (!Astro.site) throw new Error('Astro.site must be configured.');
const structuredData = [
  createThesisStructuredData(
    new URL('/research/asc-pie', Astro.site),
    Astro.site,
  ),
];
---

<BaseLayout
  title={`${thesisTitle} — Mohamed Hafez`}
  description={titleRecord.statement}
  roleId="aiml"
  openGraphType="article"
  structuredData={structuredData}
>
  <header class="longform-hero shell-container">
    <p class="utility-label">York University · M.A. research</p>
    <h1>{thesisTitle}</h1>
    <p class="longform-hero__summary">{degreeRecord.statement}</p>
    <div class="research-status" aria-label="Research status">
      <p>
        <span>Thesis</span>
        <strong>Official degree status · 2026</strong>
      </p>
      <p role="group" aria-label="SPRINT-PP status">
        <span>SPRINT-PP</span>
        <strong>{statusRecord.statement}</strong>
      </p>
    </div>
    <p class="research-page-links">
      <a href="/work/asc-pie" data-astro-prefetch="hover">Read how I built ASC-PIE →</a>
      <a href="/work/sprint-pp" data-astro-prefetch="hover">Read how I built SPRINT-PP →</a>
    </p>
  </header>

  <ResearchHighlights />

  <section
    class="research-record shell-container"
    aria-labelledby="research-framework-title"
  >
    <div class="section-heading">
      <p class="utility-label">Research framework</p>
      <h2 id="research-framework-title">
        A comparable path through privacy datasets
      </h2>
    </div>
    <ArchitectureFlow slug="asc-pie" title="ASC-PIE" />
    <div class="evidence-record-grid">
      {
        ascPieRecords
          .filter((record) =>
            [
              'asc-pie-evaluation-framework',
              'asc-pie-dataset-pipeline',
              'asc-pie-label-standardization',
              'asc-pie-experiment-stack',
            ].includes(record.id),
          )
          .map((record) => (
            <article>
              <h3>{record.title}</h3>
              <p>{record.statement}</p>
            </article>
          ))
      }
    </div>
  </section>

  <section
    class="official-records shell-container"
    aria-labelledby="official-records-title"
  >
    <div>
      <p class="utility-label">Research links</p>
      <h2 id="official-records-title">Explore the research</h2>
    </div>
    <ul>
      {
        officialSources.map((source) => (
          <li>
            <a href={source.publicHref}>{source.label}</a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .research-page-links {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  .research-page-links a {
    color: var(--color-evidence-300);
    text-decoration: none;
    font-size: var(--type-sm);
  }
</style>
