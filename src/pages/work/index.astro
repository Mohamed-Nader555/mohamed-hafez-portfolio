---
import CaseStudyCard from '@/components/case-study/CaseStudyCard.astro';
import { projects } from '@/data';
import { projectArchive } from '@/data/project-archive';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { resolveSources } from '@/lib/content/resolve-sources';
import { getCollection } from 'astro:content';

export const prerender = true;

const entries = await getCollection('caseStudies');
const detailedProjects = projects.filter(
  (project) => project.detailLevel === 'detailed',
);
const entryBySlug = new Map(entries.map((entry) => [entry.data.slug, entry]));
const orderedEntries = detailedProjects.map((project) => {
  const entry = entryBySlug.get(project.slug);
  if (!entry) throw new Error(`Missing case-study entry for ${project.slug}`);
  resolveSources(entry.data.sourceIds);
  return entry;
});

if (entries.length !== 5 || orderedEntries.length !== 5) {
  throw new Error(
    'The work index must publish exactly five detailed case studies.',
  );
}
---

<BaseLayout
  title="Selected work — Mohamed Hafez"
  description="Five engineering and research case studies covering AI/ML, software systems, and Android product delivery."
  roleId="aiml"
>
  <header class="longform-hero longform-hero--index shell-container">
    <p class="utility-label">Projects and case studies</p>
    <h1>Selected work</h1>
    <p class="longform-hero__summary">
      Five engineering projects spanning AI/ML, research, software, and Android
      delivery. Each case study explains the problem, my role, architecture,
      implementation, results, and lessons.
    </p>
  </header>

  <section
    class="work-index shell-container"
    aria-label="Detailed case studies"
  >
    {
      orderedEntries.map((entry, index) => (
        <CaseStudyCard entry={entry} index={index} />
      ))
    }
  </section>

  <section
    class="project-library shell-container"
    aria-labelledby="project-library-title"
  >
    <header class="section-heading section-heading--split">
      <div>
        <p class="utility-label">Additional work</p>
        <h2 id="project-library-title">Complete project library</h2>
      </div>
      <p>
        Client applications, enterprise systems, research, and applied
        machine-learning delivery.
      </p>
    </header>
    <div class="project-library__grid">
      {
        projectArchive.map((project) => (
          <article>
            <p class="utility-label">{project.category}</p>
            <h3>{project.title}</h3>
            <p>{project.summary}</p>
            <ul
              class="technology-list"
              aria-label={`${project.title} technologies`}
            >
              {project.technologies.map((technology) => (
                <li>{technology}</li>
              ))}
            </ul>
            {'href' in project && project.href && (
              <a href={project.href} data-astro-prefetch="viewport">
                Explore the research <span aria-hidden="true">→</span>
              </a>
            )}
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
