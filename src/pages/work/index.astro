---
import FlagshipCard from '@/components/case-study/FlagshipCard.astro';
import StoryCard from '@/components/case-study/StoryCard.astro';
import { careerExperience, teachingPortfolio } from '@/data/career';
import { projects } from '@/data/projects';
import { roles } from '@/data/roles';
import BaseLayout from '@/layouts/BaseLayout.astro';

export const prerender = true;

const pageProjects = projects.filter((project) =>
  ['flagship', 'story', 'brief'].includes(project.detailLevel),
);
const flagshipProjects = pageProjects.filter(
  (project) => project.detailLevel === 'flagship',
);
const cardProjects = projects.filter(
  (project) => project.detailLevel === 'card',
);

const focusAreaCount = roles.length;
const earliestYear = Math.min(
  ...careerExperience.flatMap((entry) => {
    const match = entry.period.match(/\d{4}/g);
    return match ? match.map(Number) : [];
  }),
);
const currentYear = new Date().getFullYear();

const keyFactsBySlug: Record<string, { value: string; label: string }[]> = {
  'asc-pie': [
    { value: '333,109', label: 'examples' },
    { value: '99.1%', label: 'best strict F1' },
  ],
  'sprint-pp': [
    { value: '83.5%', label: 'accuracy' },
    { value: '0', label: 'raw examples stored' },
  ],
  'northstar-rag': [{ value: '9', label: 'corpus documents' }],
  'minds-eye': [
    { value: 'A+', label: 'capstone grade' },
    { value: '80%+', label: 'delivered by me' },
  ],
  dive: [{ value: '4', label: 'models compared' }],
  dostava: [{ value: '8', label: 'order categories' }],
};

const groupOrder = ['ml', 'android', 'backend', 'early'] as const;
const groupLabels: Record<(typeof groupOrder)[number], string> = {
  ml: 'Machine learning',
  android: 'Android products',
  backend: 'Backend, enterprise & web',
  early: 'Early builds',
};

const storyGroups = groupOrder.map((group) => ({
  group,
  label: groupLabels[group],
  items: pageProjects.filter(
    (project) => project.detailLevel !== 'flagship' && project.group === group,
  ),
}));

const focusChips = [
  { id: 'all', label: 'All' },
  { id: 'aiml', label: 'AI & ML' },
  { id: 'software', label: 'Software' },
  { id: 'android', label: 'Android' },
  { id: 'teaching', label: 'Teaching' },
] as const;
---

<BaseLayout
  title="Projects — Mohamed Hafez"
  description="Projects and case studies across AI/ML, software, Android, and teaching."
  roleId="aiml"
>
  <header class="longform-hero longform-hero--index shell-container">
    <p class="utility-label">Projects and case studies</p>
    <h1>Things I've built</h1>
    <p class="longform-hero__summary">
      I write up the projects I can tell in full — the problem, my role, how
      they work, and what came out of them.
    </p>
    <p class="work-index__counter" aria-hidden="true">
      {pageProjects.length} project stories · {focusAreaCount} focus areas ·{
        ' '
      }
      {earliestYear} &rarr; {currentYear}
    </p>
    <p class="work-index__scope-note">
      These are the projects I can tell in full, out of nearly 50 across 40
      public repositories.
    </p>
  </header>

  <section
    class="work-index__filter shell-container"
    aria-label="Filter by focus"
  >
    <div
      class="work-index__chips"
      role="group"
      aria-label="Filter projects by focus"
    >
      {
        focusChips.map((chip) => (
          <button
            type="button"
            data-focus-chip={chip.id}
            aria-pressed={chip.id === 'all'}
          >
            {chip.label}
          </button>
        ))
      }
    </div>
    <p class="work-index__tech-pill" data-tech-pill hidden>
      <span data-tech-pill-label></span>
      <button
        type="button"
        data-tech-pill-clear
        aria-label="Clear technology filter"
      >
        ×
      </button>
    </p>
    <p class="visually-hidden" role="status" aria-live="polite" data-focus-live>
    </p>
  </section>

  <section
    class="work-index__flagships shell-container"
    aria-label="Flagship projects"
  >
    {
      flagshipProjects.map((project) => (
        <FlagshipCard project={project} keyFacts={keyFactsBySlug[project.id]} />
      ))
    }
  </section>

  {
    storyGroups.map(
      (groupEntry) =>
        groupEntry.items.length > 0 && (
          <section
            class="work-index__group shell-container"
            aria-labelledby={`group-${groupEntry.group}`}
          >
            <h2 id={`group-${groupEntry.group}`}>{groupEntry.label}</h2>
            <div class="work-index__group-grid">
              {groupEntry.items.map((project) => (
                <StoryCard project={project} />
              ))}
            </div>
          </section>
        ),
    )
  }

  <section
    class="project-library shell-container"
    aria-labelledby="project-library-title"
  >
    <header class="section-heading section-heading--split">
      <div>
        <p class="utility-label">Library</p>
        <h2 id="project-library-title">
          Smaller builds and teaching materials
        </h2>
      </div>
    </header>
    <div class="project-library__grid">
      {
        cardProjects.map((project) => (
          <article data-focus={project.roles.join(' ')}>
            <p class="utility-label">{project.category}</p>
            <h3>{project.title}</h3>
            <p>{project.hook}</p>
            <ul
              class="technology-list"
              aria-label={`${project.title} technologies`}
            >
              {project.technologies.map((technology) => (
                <li>{technology}</li>
              ))}
            </ul>
          </article>
        ))
      }
      {
        teachingPortfolio.map((item) => (
          <article data-focus="teaching">
            <p class="utility-label">Teaching · {item.period}</p>
            <h3>{item.title}</h3>
            <p>{item.detail}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section
    class="work-index__closing shell-container"
    aria-labelledby="work-closing-title"
  >
    <h2 id="work-closing-title">Want the short version?</h2>
    <ul class="work-index__resume-links">
      {
        roles.map((role) => (
          <li>
            <a href={role.resumeHref}>{role.label} résumé</a>
          </li>
        ))
      }
    </ul>
    <p>
      Or reach me directly at{' '}
      <a href="mailto:mohamed.m.nader555@gmail.com"
        >mohamed.m.nader555@gmail.com</a
      >.
    </p>
  </section>
</BaseLayout>

<script>
  import '@/lib/client/work-filter';
</script>

<style>
  .work-index__counter {
    font-family: var(--font-utility);
    font-size: var(--type-sm);
    color: var(--color-evidence-300);
    margin-top: var(--space-3);
  }

  .work-index__scope-note {
    font-size: var(--type-sm);
    color: var(--color-ink-300);
    max-inline-size: 40rem;
  }

  .work-index__filter {
    margin: var(--space-6) 0;
  }

  .work-index__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .work-index__chips button {
    padding: 0.35rem var(--space-4);
    border-radius: 999px;
    border: 1px solid var(--border-subtle);
    background: transparent;
    color: var(--color-ink-200);
    font-size: var(--type-sm);
    cursor: pointer;
  }

  .work-index__chips button[aria-pressed='true'] {
    background: color-mix(in srgb, var(--color-evidence-500) 20%, transparent);
    border-color: var(--color-evidence-500);
    color: var(--color-ink-100);
  }

  .work-index__tech-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
    padding: 0.2rem var(--space-3);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-ai-500) 18%, transparent);
    color: var(--color-ai-300);
    font-size: var(--type-xs);
  }

  .work-index__tech-pill button {
    border: none;
    background: none;
    color: inherit;
    cursor: pointer;
    font-size: var(--type-sm);
    line-height: 1;
  }

  .work-index__flagships {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
    margin: var(--space-8) 0;
  }

  .work-index__group {
    margin: var(--space-8) 0;
  }

  .work-index__group h2 {
    font-family: var(--font-display);
    font-size: var(--type-lead);
    margin-bottom: var(--space-4);
  }

  .work-index__group-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .project-library__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .project-library__grid article {
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }

  .project-library__grid h3 {
    font-size: var(--type-sm);
    margin: var(--space-1) 0;
  }

  .project-library__grid p {
    font-size: var(--type-xs);
    color: var(--color-ink-300);
  }

  .work-index__closing {
    margin: var(--space-10) 0;
    padding: var(--space-6);
    border-top: 1px solid var(--border-subtle);
  }

  .work-index__resume-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    list-style: none;
    padding: 0;
    margin: var(--space-3) 0;
  }

  .work-index__resume-links a {
    color: var(--color-evidence-300);
    text-decoration: none;
  }

  @media (max-width: 56rem) {
    .work-index__flagships,
    .work-index__group-grid {
      grid-template-columns: 1fr;
    }

    .project-library__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 40rem) {
    .project-library__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
