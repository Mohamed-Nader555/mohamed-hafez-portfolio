---
import CaseStudyLayout from '@/layouts/CaseStudyLayout.astro';
import { projects } from '@/data';
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { createCreativeWorkStructuredData } from '@/lib/seo/structured-data';

export const prerender = true;

export const getStaticPaths = (async () => {
  const entries = await getCollection('caseStudies');
  const pageProjects = projects.filter((project) =>
    ['flagship', 'story', 'brief'].includes(project.detailLevel),
  );
  const publishedSlugs = new Set(entries.map((entry) => entry.data.slug));
  const canonicalSlugs = new Set(pageProjects.map((project) => project.slug));

  if (
    entries.length !== pageProjects.length ||
    [...publishedSlugs].some((slug) => !canonicalSlugs.has(slug)) ||
    [...canonicalSlugs].some((slug) => !publishedSlugs.has(slug))
  ) {
    const missing = [...canonicalSlugs].filter(
      (slug) => !publishedSlugs.has(slug),
    );
    const extra = [...publishedSlugs].filter(
      (slug) => !canonicalSlugs.has(slug),
    );
    throw new Error(
      `Case-study routes must match every flagship/story/brief project exactly. Missing: ${missing.join(', ') || 'none'}. Extra: ${extra.join(', ') || 'none'}.`,
    );
  }

  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

interface Props {
  entry: CollectionEntry<'caseStudies'>;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const pagePath = `/work/${entry.data.slug}`;
const project = projects.find(
  (candidate) => candidate.slug === entry.data.slug,
);
if (!project) throw new Error(`Missing project record for ${entry.data.slug}`);
if (!Astro.site) throw new Error('Astro.site must be configured.');
const structuredData = [
  createCreativeWorkStructuredData(
    project,
    new URL(pagePath, Astro.site),
    Astro.site,
  ),
];
---

<CaseStudyLayout
  project={project}
  passport={entry.data.passport}
  stats={entry.data.stats}
  links={entry.data.links}
  rawBody={entry.body ?? ''}
  headings={headings}
  structuredData={structuredData}
>
  <Content />
</CaseStudyLayout>
