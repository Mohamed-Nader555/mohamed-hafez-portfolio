---
import ContactLinks from '@/components/layout/ContactLinks.astro';
import { aboutIntro } from '@/data/about';
import { questionBank } from '@/data/claims';
import { evidence, profile, screeningFacts } from '@/data';
import BaseLayout from '@/layouts/BaseLayout.astro';

export const prerender = true;

const education = evidence.find(
  (record) => record.id === 'asc-pie-degree-awarded',
);
if (!education) throw new Error('About page is missing education evidence.');

// His answers, in the file's order and under the file's headings. Gap answers
// are for the chat only and never appear on a page.
const slugify = (value: string) =>
  value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
const published = questionBank.filter((answer) => !answer.gap);
const questionGroups = [
  ...new Set(published.map((answer) => answer.group)),
].map((name) => ({
  name,
  answers: published.filter((answer) => answer.group === name),
}));
---

<BaseLayout
  title="About Mohamed Hafez"
  description="Mohamed Hafez is a Toronto-based engineer with AI/ML, software, Android, research, and teaching experience."
  roleId="aiml"
>
  <header class="longform-hero shell-container">
    <p class="utility-label">{aboutIntro.eyebrow}</p>
    <h1>{aboutIntro.heading}</h1>
    <p class="longform-hero__summary">{aboutIntro.summary}</p>
  </header>

  <section class="about-grid shell-container" aria-labelledby="screening-title">
    <div class="section-heading">
      <p class="utility-label">Current status</p>
      <h2 id="screening-title">Practical details</h2>
    </div>
    <dl>
      {
        screeningFacts.map((fact) => (
          <div>
            <dt>{fact.label}</dt>
            <dd>{fact.statement}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section
    class="education-record shell-container"
    aria-labelledby="education-title"
  >
    <div>
      <p class="utility-label">Education</p>
      <h2 id="education-title">York University</h2>
    </div>
    <div>
      <p>{education.statement}</p>
    </div>
  </section>

  <section
    id="questions"
    class="about-questions shell-container"
    aria-labelledby="questions-title"
  >
    <header>
      <p class="utility-label">Straight answers</p>
      <h2 id="questions-title">Questions I’m often asked</h2>
      <p>
        Short answers to what recruiters and hiring managers ask most. The
        portfolio assistant quotes these exactly and labels them as my answers.
      </p>
    </header>
    {
      questionGroups.map((group) => (
        <section aria-labelledby={`questions-${slugify(group.name)}`}>
          <header>
            <h3 id={`questions-${slugify(group.name)}`}>{group.name}</h3>
          </header>
          <div>
            {group.answers.map((answer) => (
              <article id={answer.id}>
                <h4>{answer.question}</h4>
                <p>{answer.answer}</p>
              </article>
            ))}
          </div>
        </section>
      ))
    }
  </section>

  <section
    class="about-contact shell-container"
    aria-labelledby="about-contact-title"
  >
    <div>
      <p class="utility-label">Contact</p>
      <h2 id="about-contact-title">Let’s connect</h2>
      <p>{profile.availability} · {profile.location}</p>
    </div>
    <ContactLinks ariaLabel="Public contact channels" variant="compact" />
  </section>
</BaseLayout>
