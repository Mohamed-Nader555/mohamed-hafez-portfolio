# Cloudflare's official local test keys; replace only through Cloudflare secrets in production.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
RATE_LIMIT_HASH_SECRET=local-test-only-not-a-production-secret
AI_MODEL=@cf/meta/llama-3.1-8b-instruct-fast
PUBLIC_TURNSTILE_SITEKEY=1x00000000000000000000AA
# Gemini API key (placeholder only; the real key goes in .dev.vars, which is
# git-ignored, and in production through `wrangler secret put GEMINI_API_KEY`).
GEMINI_API_KEY=replace-with-your-key
# Keep local runs and tests on the classic pipeline so they never call Gemini
# (and never cost money). Remove this line to try the ledger pipeline locally.
ASSISTANT_MODE=classic
