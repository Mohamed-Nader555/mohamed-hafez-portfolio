{
  "ci": {
    "collect": {
      "staticDistDir": "./dist/client",
      "url": [
        "http://localhost/",
        "http://localhost/software/",
        "http://localhost/work/northstar-rag/",
        "http://localhost/research/asc-pie/"
      ],
      "numberOfRuns": 1,
      "puppeteerScript": "./scripts/lighthouse-puppeteer.cjs",
      "puppeteerLaunchOptions": {
        "args": ["--no-sandbox", "--disable-setuid-sandbox"]
      },
      "settings": {
        "preset": "desktop",
        "onlyCategories": [
          "performance",
          "accessibility",
          "best-practices",
          "seo"
        ]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 122880 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lighthouse-results/desktop"
    }
  }
}
